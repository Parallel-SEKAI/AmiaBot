{
  "name": "amiabot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && pnpm build:css && tsc",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./assets/styles.css",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./assets/styles.css --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"{src,tests}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"{src,assets}/**/*.{ts,js,json,css,md,yml}\"",
    "format:check": "prettier --check \"{src,assets}/**/*.{ts,js,json,css,md,yml}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/node-fetch": "^2.6.13",
    "@types/opencc-js": "^1.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "handlebars": "^4.7.9",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.47.0",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "openai": "^7.20.0",
    "opencc-js": "^1.4.2",
    "p-limit": "7.3.3",
    "pg": "^8.23.0",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "xml2js": "^0.6.2",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  }
}
